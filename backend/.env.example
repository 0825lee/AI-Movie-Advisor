# Secrets stay here on the backend, never in frontend/VITE_* variables.
# Relative database paths are resolved from backend/.
DATABASE_PATH=data/movie_advisor.db
BACKEND_PORT=8000
DIFY_BASE_URL=http://127.0.0.1:18080/v1
DIFY_TIMEOUT_SECONDS=120

# Service API key of the published movie-connection-test Workflow.
DIFY_SMOKE_API_KEY=

# Configure when the three business Workflows are created.
DIFY_PROFILE_API_KEY=
DIFY_REQUEST_API_KEY=
DIFY_PERSONALIZED_API_KEY=

# Same token in the Dify HTTP node's X-Internal-Token header.
MOVIE_INTERNAL_TOKEN=

# TMDB read access token, not the DeepSeek API key.
TMDB_READ_ACCESS_TOKEN=
